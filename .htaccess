# Apache redirects for girgovalan.com (cPanel / shared hosting)
RewriteEngine On
RewriteBase /

# Force HTTPS (uncomment when SSL is active)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old flat files / cleanUrls duplicates → SEO URLs
RewriteRule ^who-is-gir-govalan(\.html)?/?$ /pages/who-is-gir-govalan/ [R=301,L]
RewriteRule ^contact(\.html)?/?$ /pages/contact/ [R=301,L]
RewriteRule ^gallery(\.html)?/?$ /pages/gallery/ [R=301,L]
RewriteRule ^blog(\.html)?/?$ /blogs/news/ [R=301,L]
RewriteRule ^products(\.html)?/?$ /collections/all/ [R=301,L]
RewriteRule ^cart\.html$ /cart/ [R=301,L]
RewriteRule ^product\.html\?id=([^&]+)$ /products/$1/ [R=301,L,QSA]
RewriteRule ^blog-post\.html\?slug=([^&]+)$ /blogs/news/$1/ [R=301,L,QSA]

# Old Shopify collection URLs
RewriteRule ^collections/ghee/?$ /collections/all/?category=ghee [R=301,L,QSA]
RewriteRule ^collections/dairy/?$ /collections/all/?category=dairy [R=301,L,QSA]
RewriteRule ^collections/sweets/?$ /collections/all/?category=sweets [R=301,L,QSA]
RewriteRule ^collections/desserts/?$ /collections/all/?category=sweets [R=301,L,QSA]
RewriteRule ^collections/seed-nuts/?$ /collections/all/?category=seeds-nuts [R=301,L,QSA]
RewriteRule ^collections/seeds-nuts/?$ /collections/all/?category=seeds-nuts [R=301,L,QSA]
RewriteRule ^collections/all/products/?$ /collections/all/ [R=301,L]

# Legacy international keyword stubs → primary country pages
RewriteRule ^a2-ghee-usa/?$ /gir-cow-ghee-usa/ [R=301,L]
RewriteRule ^a2-gir-cow-ghee-usa/?$ /gir-cow-ghee-usa/ [R=301,L]
RewriteRule ^bilona-ghee-usa/?$ /gir-cow-ghee-usa/ [R=301,L]
RewriteRule ^indian-organic-ghee-usa/?$ /gir-cow-ghee-usa/ [R=301,L]
RewriteRule ^a2-ghee-uae/?$ /a2-gir-cow-ghee-uae/ [R=301,L]
RewriteRule ^bilona-ghee-uae/?$ /a2-gir-cow-ghee-uae/ [R=301,L]
RewriteRule ^indian-ghee-dubai/?$ /a2-gir-cow-ghee-uae/ [R=301,L]

# Short /blog/* aliases
RewriteRule ^blog/benefits-of-gir-cow-ghee/?$ /blogs/news/benefits-of-gir-cow-ghee/ [R=301,L]
RewriteRule ^blog/bilona-ghee-vs-regular-ghee/?$ /blogs/news/bilona-ghee-vs-regular-ghee/ [R=301,L]
RewriteRule ^blog/gir-cow-ghee-price/?$ /blogs/news/gir-cow-ghee-price/ [R=301,L]
RewriteRule ^blog/how-to-identify-pure-ghee/?$ /blogs/news/how-to-identify-pure-ghee/ [R=301,L]


# Shopify marketplace/locale legacy URLs (GSC blocked-by-robots leftovers)
RewriteRule ^pages/buy-authentic-gir-cow-ghee-in-the-usa-free-shipping/?$ /gir-cow-ghee-usa/ [R=301,L]
RewriteRule ^pages/copy-of-copy-of-buy-authentic-gir-cow-ghee-in-the-canada/?$ /a2-gir-cow-ghee-canada/ [R=301,L]
